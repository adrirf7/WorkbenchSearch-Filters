<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>WorkbenchSearchFilters</AssemblyName>
    <RootNamespace>WorkbenchSearchFilters</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- Ruta de instalación de Valheim. Se puede cambiar con: dotnet build -p:ValheimDir="D:\...\Valheim" -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExDir>$(ValheimDir)\BepInEx</BepInExDir>
    <!-- Copiar automáticamente el .dll a BepInEx\plugins al compilar -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="gui_framework">
      <HintPath>$(ManagedDir)\gui_framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Se copia a BepInEx\scripts: ScriptEngine lo carga desde ahí y lo recarga en caliente al cambiar el .dll -->
  <Target Name="DeployToValheim" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(BepInExDir)\scripts" />
    <!-- ScriptEngine siempre lee los símbolos: sin el .pdb al lado no carga el .dll -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb;$(TargetPath)" DestinationFolder="$(BepInExDir)\scripts" />
    <Message Importance="high" Text="WorkbenchSearchFilters copiado a $(BepInExDir)\scripts (ScriptEngine lo recarga solo)" />
  </Target>

  <!-- En Release, crea en release\ el zip para Nexus Mods y el de Thunderstore -->
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageName>WorkbenchSearchFilters</PackageName>
      <PackageDir>$(MSBuildProjectDirectory)\obj\package</PackageDir>
      <ReleaseDir>$(MSBuildProjectDirectory)\release</ReleaseDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <MakeDir Directories="$(ReleaseDir)" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDir)\nexus\BepInEx\plugins\WorkbenchSearchFilters" />
    <ZipDirectory SourceDirectory="$(PackageDir)\nexus" DestinationFile="$(ReleaseDir)\$(PackageName)-$(Version)-nexus.zip" Overwrite="true" />

    <Copy SourceFiles="$(TargetPath);thunderstore\manifest.json;thunderstore\README.md;thunderstore\icon.png" DestinationFolder="$(PackageDir)\thunderstore" />
    <ZipDirectory SourceDirectory="$(PackageDir)\thunderstore" DestinationFile="$(ReleaseDir)\$(PackageName)-$(Version)-thunderstore.zip" Overwrite="true" />

    <Message Importance="high" Text="Paquetes de Nexus y Thunderstore creados en $(ReleaseDir)" />
  </Target>

</Project>
